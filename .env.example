# Copy this file to ".env" and fill it in. Never commit ".env".

# --- Neon -------------------------------------------------------------------
# neon.tech -> your project -> Dashboard -> "Connect" -> turn ON "Connection pooling"
# and copy the connection string. It looks like this:
DATABASE_URL=postgresql://USER:PASSWORD@ep-something-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Secrets (make them with:  npm run secrets ) ------------------------------
# Signs the login tokens (JWT). At least 32 characters. Changing it signs everyone out.
JWT_SECRET=
# Protects the 6 digit recovery codes stored in the database. At least 32 characters.
# NEVER change it after people have accounts, or their recovery codes stop working.
RECOVERY_PEPPER=

# --- Optional ---------------------------------------------------------------
# PORT=3001
# SESSION_DAYS=7
# Set to 1 when the app runs behind a proxy/load balancer (Render, Railway, Fly, ...), so rate limits see real visitor IPs
# TRUST_PROXY=1
# Only set to "false" to try the production build over plain http on your own network
# COOKIE_SECURE=false
